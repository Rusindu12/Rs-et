# The exact OpenAI-compatible chat-completions URL of your self-hosted model.
# Example: https://your-hf-space.hf.space/v1/chat/completions
LLM_ENDPOINT=
LLM_MODEL=meta-llama/Llama-3.2-3B-Instruct

# Optional. Keep this only on Render/HF Space backend secrets, NEVER in Flutter.
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=75

# Restrict this to your app's trusted origins before production.
CORS_ORIGINS=*

# Optional path to Noto Sans Sinhala or another Sinhala-capable TTF for PDFs.
EDUMATE_PDF_FONT_PATH=
