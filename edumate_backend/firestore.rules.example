rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Published course content and past-paper metadata are read-only to students.
    match /grades/{gradeId}/subjects/{subjectId}/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // A signed-in learner can only read/write their own profile and study data.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
