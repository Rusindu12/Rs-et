# ============================================================================
#  RS AI — Smart Mode config
#  මේ file එක copy කරලා "server/.env" කියලා save කරලා, key එක දාන්න.
#  ඊට පස්සේ හුරතල්:  python server/main.py   (smart mode auto-on ⚡)
#  (.env git එකට commit වෙන්නේ නෑ — key එක safe)
# ============================================================================

# ---- Option 1: Groq (recommended — FREE, super fast Llama 3.3 70B) ---------
# Key එක ගන්න: https://console.groq.com  ->  API Keys  ->  Create API Key
RS_PROVIDER=groq
RS_API_KEY=gsk_REPLACE_ME

# ---- Option 2: Gemini (FREE) ------------------------------------------------
# Key එක ගන්න: https://aistudio.google.com  ->  Get API key
# RS_PROVIDER=gemini
# RS_API_KEY=AIza_REPLACE_ME
# RS_EXT_MODEL=gemini-2.0-flash

# ---- Option 3: OpenAI -------------------------------------------------------
# RS_PROVIDER=openai
# RS_API_KEY=sk-REPLACE_ME
# RS_EXT_MODEL=gpt-4o-mini

# ---- Option 4: ඕනම OpenAI-compatible endpoint (Ollama/Together/vLLM...) ----
# RS_PROVIDER=custom
# RS_BASE_URL=http://localhost:11434/v1
# RS_EXT_MODEL=llama3.1
# RS_API_KEY=ollama

# ---- Local model එක විතරක් use කරන්න නම් ------------------------------------
# RS_PROVIDER=local

# ---- Security: public deploy එකක් නම් API token එකක් දාන්න -------------------
# සර්වර් එකට clients ලාට දෙන්නෙත් මේකම (app Settings → API token / web ?token=)
# RS_API_TOKEN=MySecret123

# ---- Smart modes model overrides (optional) ----------------------------------
# RS_MODEL_THINK=deepseek-r1-distill-llama-70b     # 💡🧠 thinking modes
# RS_MODEL_VISION=meta-llama/llama-4-scout-17b-16e-instruct   # 📷 photos
# RS_IMAGE_MODEL=dall-e-3      # 🎨 OpenAI images API (unset = free key-less images)
# RS_RATE_LIMIT_PER_MIN=120    # 🛡️ per-IP limit (0 = off) — public deploy වලට recommend
# RS_FORCE_CPU=1               # GPU ignore කරලා CPU run

